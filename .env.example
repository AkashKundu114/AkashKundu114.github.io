# Akash Kundu Portfolio - Environment Variables Template
# Copy this file to .env and adjust variables as required.
# In GitHub Actions, configure these in Repository Settings -> Secrets and variables -> Actions.

# Administrative Authentication Hash (SHA-256)
# Client-side hash used by the demonstration Admin management panel at /#/admin.
# To generate a new hash: echo -n "your-secret-password" | sha256sum
VITE_ADMIN_PASSWORD_HASH=45cbd2273491a7d411b202c15a0ca20bbc270d3fc838cfd7f363d30e8d5a83be

# Contact Form Submission Endpoint
# URL for the contact submission endpoint (FastAPI microservice or fallback provider).
VITE_CONTACT_API=https://api.akashkundu.me/api/contact
